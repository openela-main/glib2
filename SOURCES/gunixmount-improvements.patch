+   */
+  "/",              /* we already have "Filesystem root" in Nautilus */
+  "/bin",
+  "/boot",
+  "/compat/linux/proc",
+  "/compat/linux/sys",
+  "/dev",
+  "/etc",
+  "/home",
+  "/lib",
+  "/lib64",
+  "/libexec",
+  "/live/cow",
+  "/live/image",
+  "/media",
+  "/mnt",
+  "/net",
+  "/opt",
+  "/proc",
+  "/rescue",
+  "/root",
+  "/sbin",
+  "/sbin",
+  "/srv",
+  "/sys",
+  "/tmp",
+  "/usr",
+  "/usr/X11R6",
+  "/usr/local",
+  "/usr/obj",
+  "/usr/ports",
+  "/usr/src",
+  "/usr/xobj",
+  "/var",
+  "/var/crash",
+  "/var/local",
+  "/var/log",
